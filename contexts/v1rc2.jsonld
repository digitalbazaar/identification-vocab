        },
        "address": {
          "@id": "https://w3id.org/identification#address",
          "@type": "@id"
        },
        "birthDate": {
          "@id": "https://schema.org/birthDate",
          "@type": "http://www.w3.org/2001/XMLSchema#date"
        },
        "email": {
          "@id": "https://schema.org/email",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "familyName": {
          "@id": "https://w3id.org/identification#familyName",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "givenName": {
          "@id": "https://schema.org/givenName",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "identificationDocument": {
          "@id": "https://w3id.org/identification#identificationDocument",
          "@type": "@id"
        },
        "image": {
          "@id": "https://w3id.org/identification#image",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "telephone": {
          "@id": "https://schema.org/telephone",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "worksFor": {
          "@id": "https://schema.org/worksFor",
          "@type": "@id"
        },
        "name": {
          "@id": "https://schema.org/name"
        }
      }
    },
    "Organization": {
      "@id": "https://schema.org/Organization",
      "@context": {
        "@protected": true,
        "address": {
          "@id": "https://w3id.org/identification#address",
          "@type": "@id"
        },
        "department": {
          "@id": "https://schema.org/department",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "email": {
          "@id": "https://schema.org/email",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "logo": {
          "@id": "https://schema.org/logo",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "telephone": {
          "@id": "https://schema.org/telephone",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "url": {
          "@id": "https://schema.org/url",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "name": {
          "@id": "https://schema.org/name"
        },
        "description": {
          "@id": "https://schema.org/description"
        }
      }
    },
    "PostalAddress": {
      "@id": "https://schema.org/PostalAddress",
      "@context": {
        "@protected": true,
        "addressCountry": {
          "@id": "https://schema.org/addressCountry",
